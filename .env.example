POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=indenance
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/indenance

# JWT session token
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30m

# Refresh token (stored hashed in DB, delivered as httpOnly cookie)
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Frontend redirect after OAuth callback (optional)
FRONTEND_URL=

# Resend transactional email
RESEND_API_KEY=
EMAIL_FROM=Indenance <onboarding@resend.dev>
