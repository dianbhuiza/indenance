// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String     @id @default(uuid())
  email                    String     @unique
  name                     String?
  phone                    String?
  emailVerifiedAt          DateTime?
  role                     Role       @default(USER)
  passwordResetTokenHash   String?    @unique
  passwordResetExpiresAt   DateTime?
  accounts                 Account[]
  tenant                   Tenant?    @relation(fields: [tenantId], references: [id])
  tenantId                 String?
  authMethods              AuthMethod[]
  refreshTokens            RefreshToken[]
}

enum Role {
  USER
  ADMIN
}

model RefreshToken {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           String
  tokenHash          String    @unique
  expiresAt          DateTime
  createdAt          DateTime  @default(now())
  revokedAt          DateTime?
  replacedByTokenHash String?  @unique
}

model AuthMethod {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  password          String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
}

model Tenant {
  id                  String               @id @default(uuid())
  name                String
  users               User[]
  categories          Category[]
  transactions        Transaction[]
  budgets             Budget[]
  plannedTransactions PlannedTransaction[]
  plannedTransactionAlerts PlannedTransactionAlert[]
  shoppingLists       ShoppingList[]
  accounts            Account[]
  loans               Loan[]
}

model Account {
  id                  String               @id @default(uuid())
  userId              String
  user                User                 @relation(fields: [userId], references: [id])
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  name                String
  currency            String
  balance             Int                  @default(0)
  transactions        Transaction[]
  plannedTransactions PlannedTransaction[]
  plannedTransactionAlerts PlannedTransactionAlert[]
  loans               Loan[]

  @@index([userId, tenantId])
}

model Transaction {
  id         String          @id @default(uuid())
  accountId  String
  account    Account         @relation(fields: [accountId], references: [id])
  amount     Int
  type       TransactionType
  createdAt  DateTime        @default(now())
  category   Category?       @relation(fields: [categoryId], references: [id])
  categoryId String?
  Tenant     Tenant          @relation(fields: [tenantId], references: [id])
  tenantId   String
  plannedTransactionAlert PlannedTransactionAlert?
  loanInstallments LoanInstallment[]
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Category {
  id                  String               @id @default(uuid())
  name                String
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  transactions        Transaction[]
  budgets             Budget[]
  plannedTransactions PlannedTransaction[]
  plannedTransactionAlerts PlannedTransactionAlert[]
  shoppingListItems   ShoppingListItem[]
  loans               Loan[]
}

model Budget {
  id          String    @id @default(uuid())
  name        String
  amount      Int
  startDate   DateTime
  endDate     DateTime?
  isRecurring Boolean   @default(false)
  interval    Interval?
  exceededAt  DateTime?
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  String?

  @@index([tenantId])
}

model PlannedTransaction {
  id          String                @id @default(uuid())
  accountId   String
  account     Account               @relation(fields: [accountId], references: [id])
  amount      Int
  isRecurring Boolean               @default(false)
  interval    Interval?
  type        TransactionType
  scheduledAt DateTime
  category    Category?             @relation(fields: [categoryId], references: [id])
  categoryId  String?
  Tenant      Tenant                @relation(fields: [tenantId], references: [id])
  tenantId    String
  deletedAt   DateTime?
  status      PlannedTransactionStatus @default(ACTIVE)
  requiresApproval Boolean          @default(true)
  occurrences Int?
  completedOccurrences Int          @default(0)
  loan        Loan?                 @relation(fields: [loanId], references: [id])
  loanId      String?               @unique
  alerts      PlannedTransactionAlert[]
}

enum Interval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum PlannedTransactionStatus {
  ACTIVE
  COMPLETED
}

enum PlannedTransactionAlertStatus {
  PENDING
  APPROVED
  REJECTED
}

model PlannedTransactionAlert {
  id                   String                     @id @default(uuid())
  plannedTransactionId String
  plannedTransaction   PlannedTransaction         @relation(fields: [plannedTransactionId], references: [id], onDelete: Cascade)
  tenantId             String
  tenant               Tenant                     @relation(fields: [tenantId], references: [id])
  accountId            String
  account              Account                    @relation(fields: [accountId], references: [id])
  amount               Int
  type                 TransactionType
  categoryId           String?
  category             Category?                  @relation(fields: [categoryId], references: [id])
  dueAt                DateTime
  status               PlannedTransactionAlertStatus @default(PENDING)
  transactionId        String?                    @unique
  transaction          Transaction?               @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  loanInstallmentId    String?
  loanInstallment      LoanInstallment?           @relation(fields: [loanInstallmentId], references: [id], onDelete: SetNull)
  createdAt            DateTime                   @default(now())
  resolvedAt           DateTime?

  @@unique([plannedTransactionId, dueAt])
  @@index([status, dueAt])
}

model ShoppingList {
  id          String             @id @default(uuid())
  name        String
  items       ShoppingListItem[]
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  deletedAt   DateTime?
  purchasedAt DateTime?

  @@index([tenantId])
}

model ShoppingListItem {
  id             String       @id @default(uuid())
  name           String
  quantity       Int          @default(1)
  isPurchased    Boolean      @default(false)
  shoppingListId String
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id])
  categoryId     String?
  category       Category?    @relation(fields: [categoryId], references: [id])
  price          Int?

  @@index([shoppingListId])
}

enum LoanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum LoanInstallmentStatus {
  PENDING
  PAID
}

model Loan {
  id                String             @id @default(uuid())
  name              String?
  accountId         String
  account           Account            @relation(fields: [accountId], references: [id])
  tenantId          String
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  principal         Int
  interestPercent   Float?
  totalRepayment    Int
  interestAmount    Int
  installments      Int
  installmentAmount Int
  interval          Interval
  startDate         DateTime
  status            LoanStatus         @default(ACTIVE)
  deletedAt         DateTime?
  createdAt         DateTime           @default(now())
  category          Category?          @relation(fields: [categoryId], references: [id])
  categoryId        String?
  plannedTransaction PlannedTransaction?
  installmentRecords LoanInstallment[]

  @@index([tenantId])
}

model LoanInstallment {
  id             String                @id @default(uuid())
  loanId         String
  loan           Loan                  @relation(fields: [loanId], references: [id], onDelete: Cascade)
  number         Int
  dueAt          DateTime
  amount         Int
  status         LoanInstallmentStatus @default(PENDING)
  paidAt         DateTime?
  transactionId  String?               @unique
  transaction    Transaction?          @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  alerts         PlannedTransactionAlert[]

  @@unique([loanId, number])
  @@index([loanId, status])
}