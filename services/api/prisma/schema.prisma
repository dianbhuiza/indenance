// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  name            String?
  phone           String?
  emailVerifiedAt DateTime?
  accounts        Account[]
  tenant          Tenant?        @relation(fields: [tenantId], references: [id])
  tenantId        String?
  authMethods     AuthMethod[]
  refreshTokens   RefreshToken[]
}

model RefreshToken {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           String
  tokenHash          String    @unique
  expiresAt          DateTime
  createdAt          DateTime  @default(now())
  revokedAt          DateTime?
  replacedByTokenHash String?  @unique
}

model AuthMethod {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  password          String?
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
}

model Tenant {
  id                  String               @id @default(uuid())
  name                String
  users               User[]
  categories          Category[]
  transactions        Transaction[]
  budgets             Budget[]
  plannedTransactions PlannedTransaction[]
  plannedTransactionAlerts PlannedTransactionAlert[]
  shoppingLists       ShoppingList[]
  accounts            Account[]
}

model Account {
  id                  String               @id @default(uuid())
  userId              String
  user                User                 @relation(fields: [userId], references: [id])
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  name                String
  currency            String
  balance             Int                  @default(0)
  transactions        Transaction[]
  plannedTransactions PlannedTransaction[]
  plannedTransactionAlerts PlannedTransactionAlert[]

  @@index([userId, tenantId])
}

model Transaction {
  id         String          @id @default(uuid())
  accountId  String
  account    Account         @relation(fields: [accountId], references: [id])
  amount     Int
  type       TransactionType
  createdAt  DateTime        @default(now())
  category   Category?       @relation(fields: [categoryId], references: [id])
  categoryId String?
  Tenant     Tenant          @relation(fields: [tenantId], references: [id])
  tenantId   String
  plannedTransactionAlert PlannedTransactionAlert?
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Category {
  id                  String               @id @default(uuid())
  name                String
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  transactions        Transaction[]
  budgets             Budget[]
  plannedTransactions PlannedTransaction[]
  plannedTransactionAlerts PlannedTransactionAlert[]
  shoppingListItems   ShoppingListItem[]
}

model Budget {
  id          String    @id @default(uuid())
  name        String
  amount      Int
  startDate   DateTime
  endDate     DateTime?
  isRecurring Boolean   @default(false)
  interval    Interval?
  exceededAt  DateTime?
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  String?

  @@index([tenantId])
}

model PlannedTransaction {
  id          String                @id @default(uuid())
  accountId   String
  account     Account               @relation(fields: [accountId], references: [id])
  amount      Int
  isRecurring Boolean               @default(false)
  interval    Interval?
  type        TransactionType
  scheduledAt DateTime
  category    Category?             @relation(fields: [categoryId], references: [id])
  categoryId  String?
  Tenant      Tenant                @relation(fields: [tenantId], references: [id])
  tenantId    String
  deletedAt   DateTime?
  status      PlannedTransactionStatus @default(ACTIVE)
  alerts      PlannedTransactionAlert[]
}

enum Interval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum PlannedTransactionStatus {
  ACTIVE
  COMPLETED
}

enum PlannedTransactionAlertStatus {
  PENDING
  APPROVED
  REJECTED
}

model PlannedTransactionAlert {
  id                   String                     @id @default(uuid())
  plannedTransactionId String
  plannedTransaction   PlannedTransaction         @relation(fields: [plannedTransactionId], references: [id], onDelete: Cascade)
  tenantId             String
  tenant               Tenant                     @relation(fields: [tenantId], references: [id])
  accountId            String
  account              Account                    @relation(fields: [accountId], references: [id])
  amount               Int
  type                 TransactionType
  categoryId           String?
  category             Category?                  @relation(fields: [categoryId], references: [id])
  dueAt                DateTime
  status               PlannedTransactionAlertStatus @default(PENDING)
  transactionId        String?                    @unique
  transaction          Transaction?               @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt            DateTime                   @default(now())
  resolvedAt           DateTime?

  @@index([status, dueAt])
  @@index([plannedTransactionId])
}

model ShoppingList {
  id          String             @id @default(uuid())
  name        String
  items       ShoppingListItem[]
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  deletedAt   DateTime?
  purchasedAt DateTime?

  @@index([tenantId])
}

model ShoppingListItem {
  id             String       @id @default(uuid())
  name           String
  quantity       Int          @default(1)
  isPurchased    Boolean      @default(false)
  shoppingListId String
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id])
  categoryId     String?
  category       Category?    @relation(fields: [categoryId], references: [id])
  price          Int?

  @@index([shoppingListId])
}